# Copy this file to .env.local and fill in real values.

# Supabase — from your project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the client

# Random secret used to sign the shop-code session cookie.
# Generate one with: openssl rand -hex 32
SHOP_SESSION_SECRET=

# Resend — from https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL="Loan Qualifier Tool <onboarding@resend.dev>"

# VP notification recipient (Section 9)
VP_EMAIL=
VP_NAME=
